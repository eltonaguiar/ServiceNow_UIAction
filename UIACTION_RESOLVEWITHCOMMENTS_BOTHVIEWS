if (typeof window == 'undefined') {
  var reason = (current.close_notes + '').trim();
  try {
    reason = reason || current.comments.getJournalEntry(1) || current.work_notes.getJournalEntry(1) || '';
  } catch (e) {}

  if (!reason) {
    gs.addErrorMessage('Comments or work notes are required to resolve this incident.');
    current.setAbortAction(true);
    action.setRedirectURL(current);
  } else {
    current.state = 6;
    current.incident_state = 6;
    current.close_code = 'No resolution provided';
    current.close_notes = reason;
    current.update();
    action.setRedirectURL(current);
  }
}
